# ============================================================================
# AGENTHIVE — Graph Hacks 2026 (Track 02: Agent Memory and Coordination)
# Copy this file to .env:
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
# ============================================================================

# Application Mode: "demo" enables seeded demo tenants (alpha-eng, beta-sec)
# "production" requires strict X-Tenant-Token authentication headers
AGENTHIVE_ENV=demo
AGENTHIVE_HOST=0.0.0.0
AGENTHIVE_PORT=8000
LOG_LEVEL=INFO

# FalkorDB Connection (Load-Bearing Primary Graph Database - C-01)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_CONTROL_GRAPH=ah_control

# Extraction Provider Configuration (C-03, NFR-004)
# Options: "deterministic" ($0 offline default), "ollama", "gemini"
EXTRACTION_PROVIDER=deterministic
EXTRACTION_WORKER_ENABLED=true
EXTRACTION_POLL_INTERVAL_SECONDS=1.5
EXTRACTION_SIMULATE_OUTAGE=false

# Optional Providers (Not required for the $0 seeded demo path)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
DEMO_DEFAULT_TENANT=alpha-eng
PRODUCTION_TENANT_TOKENS_JSON={}

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1